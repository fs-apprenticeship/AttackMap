// Database: Neon (serverless Postgres)
//
// Connection strings (.env):
//   DATABASE_URL  — pooled URL  (application queries)
//   DIRECT_URL    — direct URL  (prisma db push / migrations)
//
// Promote to migrations (prisma migrate dev) when the first real column
// change lands (e.g. userId). Until then, prisma db push is sufficient.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

// ---------------------------------------------------------------------------
// Scans
// ---------------------------------------------------------------------------
// The full ScanSchema-validated object lives in `data` (jsonb). Promoted
// columns exist only for ordering and future filtering — do not duplicate
// the shape here.
//
// host.id and service.id are scan-local, not globally unique, so a
// normalized schema would require artificial PKs. jsonb avoids that entirely.

model Scan {
  id        String    @id              // scan_<cuid>, assigned by the parser
  target    String
  filename  String
  scannedAt DateTime?
  parsedAt  DateTime
  data      Json                       // ScanSchema-validated scan object
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@map("scans")
}
