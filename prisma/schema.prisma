// Transitional normalized schema.
// userId is nullable — becomes required when the User model and Clerk webhook land.
//
// Connection strings (.env):
//   DATABASE_URL  — pooled URL  (application queries)
//   DIRECT_URL    — direct URL  (prisma db push / migrations)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RiskLevel {
  critical
  high
  medium
  low
  info
}

enum Protocol {
  tcp
  udp
}

enum AiSource {
  ai
  rule_based
}

enum ScanImportStatus {
  queued
  validating
  parsing
  saving
  complete
  failed
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------
// id mirrors the Clerk user ID. Clerk owns auth; we mirror the record here
// for FK relationships. Created via JIT upsert in lib/auth/sync.ts.

model User {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  scans            Scan[]
  scanImportJobs   ScanImportJob[]
  scanUploadChunks ScanUploadChunk[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Scans
// ---------------------------------------------------------------------------

model Scan {
  id         String    @id
  userId     String?   @map("user_id")
  filename   String
  target     String
  scannedAt  DateTime? @map("scanned_at")
  uploadedAt DateTime  @default(now()) @map("uploaded_at")
  parsedAt   DateTime  @map("parsed_at")
  // Hosts nmap reported as down: [{ ipAddress, hostname? }]. Kept separately
  // from `hosts` (which only holds up hosts) so Compare can tell "scanned
  // and found down" apart from "not in this scan's target range at all".
  downHosts  Json      @default("[]") @map("down_hosts")

  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  hosts     Host[]
  findings  Finding[]
  aiSummary AiSummary?
  importJob ScanImportJob?

  @@index([userId])
  @@map("scans")
}

// ---------------------------------------------------------------------------
// Hosts
// ---------------------------------------------------------------------------

model Host {
  id              String  @id
  scanId          String  @map("scan_id")
  ipAddress       String  @map("ip_address")
  hostname        String?
  operatingSystem String  @map("operating_system")
  role            String
  internetExposed Boolean @default(false) @map("internet_exposed")

  scan     Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  services Service[]
  findings Finding[]

  @@index([scanId])
  @@unique([scanId, ipAddress], map: "hosts_scan_id_ip_address_key")
  @@map("hosts")
}

// ---------------------------------------------------------------------------
// Services
// ---------------------------------------------------------------------------

model Service {
  id          String    @id
  hostId      String    @map("host_id")
  port        Int
  protocol    Protocol
  serviceName String    @map("service_name")
  product     String?
  version     String?
  extrainfo   String?
  cpe         String[]
  riskLevel   RiskLevel @map("risk_level")

  host Host @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
  @@unique([hostId, port, protocol], map: "services_host_id_port_protocol_key")
  @@map("services")
}

// ---------------------------------------------------------------------------
// Findings
// ---------------------------------------------------------------------------

model Finding {
  id          String    @id
  scanId      String    @map("scan_id")
  hostId      String?   @map("host_id")
  severity    RiskLevel
  title       String
  evidence    String    @db.Text
  remediation String    @db.Text

  scan Scan  @relation(fields: [scanId], references: [id], onDelete: Cascade)
  host Host? @relation(fields: [hostId], references: [id], onDelete: SetNull)

  @@index([scanId])
  @@index([severity])
  @@unique([scanId, hostId, severity, title], map: "findings_natural_key")
  @@map("findings")
}

// ---------------------------------------------------------------------------
// AI Summaries
// ---------------------------------------------------------------------------

model AiSummary {
  id          String    @id @default(cuid())
  scanId      String    @unique @map("scan_id")
  executive   String    @db.Text
  riskScore   Int       @map("risk_score")
  riskLevel   RiskLevel @map("risk_level")
  topRisks    Json      @map("top_risks")
  remediation Json?
  source      AiSource
  createdAt   DateTime  @default(now()) @map("created_at")

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@map("ai_summaries")
}

// ---------------------------------------------------------------------------
// Scan import jobs (large-file async processing)
// ---------------------------------------------------------------------------
// Persisted job record for the large-scan (> MAX_SCAN_UPLOAD_BYTES) upload
// path. Replaces an in-memory job map, which does not survive Vercel
// serverless cold starts and isn't shared across instances. See
// docs/LARGE_SCAN_PROCESSING.md.

model ScanImportJob {
  id            String           @id @default(cuid())
  userId        String           @map("user_id")
  filename      String
  fileSizeBytes Int              @map("file_size_bytes")
  // Points at the ScanUploadChunk rows for this upload (see below), not a
  // Vercel Blob URL — this app has no Vercel dashboard access to attach Blob
  // storage, so large files are chunked and reassembled from Postgres
  // instead. Kept distinct from `id` so a client can start uploading chunks
  // before the job row exists (the job is only created once all chunks are
  // in, by the finalize call).
  uploadId      String           @map("upload_id")
  status        ScanImportStatus @default(queued)
  scanId        String?          @unique @map("scan_id")
  errorCode     String?          @map("error_code")
  errorMessage  String?          @map("error_message") @db.Text
  attempts      Int              @default(0)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scan Scan? @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, updatedAt])
  @@map("scan_import_jobs")
}

// ---------------------------------------------------------------------------
// Scan upload chunks (large-file transport, no Blob storage required)
// ---------------------------------------------------------------------------
// Vercel Functions hard-cap request bodies at 4.5MB, so a large scan can't be
// received in one request. The client splits it client-side and PUTs each
// piece here; once all chunks for an uploadId are present, the finalize call
// reassembles them in order and hands the result to the same parser/save
// pipeline the Blob-backed design would have used. Rows are deleted once
// their job reaches a terminal state (see processScanImportJob).

model ScanUploadChunk {
  id         String   @id @default(cuid())
  uploadId   String   @map("upload_id")
  userId     String   @map("user_id")
  chunkIndex Int      @map("chunk_index")
  data       Bytes
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([uploadId, chunkIndex], map: "scan_upload_chunks_upload_id_chunk_index_key")
  @@index([uploadId])
  @@map("scan_upload_chunks")
}
