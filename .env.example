# Environment variables. Copy the values you need into a local env file and fill
# in real values. All env files are gitignored — never commit real secrets.
#
# Note on which file:
#   - Next.js reads both `.env` and `.env.local`.
#   - The Prisma CLI (db push / generate) reads only `.env`.
# So put the database URLs in `.env`, and OpenAI keys can live in `.env.local`.

# --- Clerk (.env.local) ----------------------------------------------------
# Both come from the Clerk dashboard → API Keys.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY powers the client-side UI (SignIn, UserButton, etc.).
# CLERK_SECRET_KEY is required for server-side session validation — without it
# the proxy cannot verify JWTs and auth() returns null for every request.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
CLERK_SECRET_KEY=sk_test_your-key-here

# --- OpenAI (.env.local) ---------------------------------------------------
# Used server-side to generate AI scan summaries. Get one at:
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
# Model for AI scan summaries. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini

# --- NVD / CVE lookup (.env.local) -----------------------------------------
# Optional. Used by the CVE lookup tool to query the NVD API. Without a key NVD
# allows 5 requests / 30s; a key raises that to 50 / 30s. Request one (free) at:
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your-nvd-api-key-here

# --- Database / Neon (.env) ------------------------------------------------
# Both come from the Neon dashboard.
# DATABASE_URL: the POOLED connection string (host contains "-pooler"). Used by
# the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# DIRECT_URL: the DIRECT connection string (no "-pooler"). Used by Prisma for
# `prisma db push` / migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
