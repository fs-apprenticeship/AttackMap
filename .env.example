# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.

# OpenAI API key, used server-side to generate AI scan summaries.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Model used for AI scan summaries. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini

DATABASE_URL= pooled connection string for Neon. Get this from the Neon dashboard. It should contain this: pooler
DIRECT_URL= direct connection string for Neon. Get this from the Neon dashboard. It should be commented out